#!/usr/bin/env bash
# Mechanical write-scope guard for the gabagool lab shift.
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" != "gabagool-lab" ]; then
  echo "[guard] commits allowed only on gabagool-lab (on: $branch)" >&2
  exit 1
fi
bad="$(git diff --cached --name-only | grep -vE '^(gabagool-lab/|src/strategies/gabagool-lab/)' || true)"
if [ -n "$bad" ]; then
  echo "[guard] BLOCKED — staged files outside gabagool-lab/ and src/strategies/gabagool-lab/:" >&2
  echo "$bad" >&2
  echo "[guard] unstage them; the lab may write only inside those two paths." >&2
  exit 1
fi
# DONE is the mission-end sentinel (charter: L3 only). A stray empty DONE
# appeared+vanished externally on 2026-07-17 (s3 u14a) and a git add -A
# swept it into a commit. Block ADDING it unless explicitly authorized;
# removing it stays allowed.
if git diff --cached --name-only --diff-filter=A | grep -qx 'gabagool-lab/DONE'; then
  if [ "${GLAB_L3_DONE:-}" != "yes" ]; then
    echo "[guard] BLOCKED — gabagool-lab/DONE staged for addition. Only the L3" >&2
    echo "[guard] mission-end commit may add it: GLAB_L3_DONE=yes git commit ..." >&2
    exit 1
  fi
fi
exit 0
