DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=password
DATABASE_NAME=polymarket_bot



# when do we book a fill 'MATCHED' | 'MINED' | 'CONFIRMED'
USER_WS_FILL_AT_STATUS=MATCHED

ENABLE_WEB_UI=true
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=3001
WEB_UI_REFRESH_MS=250
WEB_UI_ORDERBOOK_LEVELS=8
BOT_INSTANCE_ID=my-first-bot

LOG_TO_FILE=true

BACKTEST_LATENCY_DELAY=140
BACKTEST_LATENCY_JITTER=20


# this is CLOB api key, secret, passphrase...
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
PRIVATE_KEY=
CLOB_FUNDER=<safeAddress>
CLOB_SIGNATURE_TYPE=2
# builder + relay
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com/
POLYMARKET_RELAYER_CHAIN_ID=137
POLYMARKET_RELAYER_TX_TYPE=SAFE
POLYMARKET_TX_MODE_SPLIT=relayer
POLYMARKET_TX_MODE_MERGE=relayer
POLYGON_RPC_URL=https://polygon-rpc.com
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com


REDEEM_WATCH_INTERVAL_MS=30000
REDEEM_LOOKBACK_HOURS=48
REDEEM_MAX_MARKETS_PER_TICK=20
REDEEM_STATE_PATH=data/redeem/redeemed.json

RECORD_LIVE_INSERT_DB=true