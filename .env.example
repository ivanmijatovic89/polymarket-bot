DATABASE_URL="postgresql://mijat:@localhost:5432/polymarket_bot"

# Azure Blob Storage connection string (required for --azure mode)
AZURE_STORAGE_CONNECTION_STRING=

# Parallel processing configuration (optional - these are the defaults)
# Number of concurrent Azure blob downloads (default: 8)
AZURE_DOWNLOAD_CONCURRENCY=8

# Number of concurrent file processing workers (default: 2, recommended: match CPU cores)
PROCESS_CONCURRENCY=2

# Number of files to process per batch before cleanup (default: 10)
BATCH_SIZE=10

# Initial capital for backtest (default: 10000)
INITIAL_CAPITAL=10000