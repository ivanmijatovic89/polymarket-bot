DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=password
DATABASE_NAME=polymarket_bot

# Optional (set in shell, not here): BOT_ENV=botA -> loads .env.botA
BOT_ENV=

INITIAL_CAPITAL=1000

# when do we book a fill 'MATCHED' | 'MINED' | 'CONFIRMED'
USER_WS_FILL_AT_STATUS=MATCHED

ENABLE_WEB_UI=true
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=3001
WEB_UI_REFRESH_MS=250
WEB_UI_ORDERBOOK_LEVELS=10
BOT_INSTANCE_ID=my-first-bot

LOG_TO_FILE=true

BACKTEST_LATENCY_DELAY=140
BACKTEST_LATENCY_JITTER=20


# this is CLOB api key, secret, passphrase...
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# of EAO wallet
PRIVATE_KEY=
# builder + relay
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com/
POLYMARKET_RELAYER_CHAIN_ID=137
POLYMARKET_RELAYER_TX_TYPE=SAFE

### TO USE RELAYER ( SAFE WALLET + GASSLESS)
# POLYMARKET_TX_MODE_SPLIT=relayer
# POLYMARKET_TX_MODE_MERGE=relayer
# POLYMARKET_TX_MODE_REDEEM=relayer
# CLOB_FUNDER=0x...YourSafeWalletAddress
# CLOB_SIGNATURE_TYPE=2
### TO USE EOA ( METAMASK + PAY TX GAS )
POLYMARKET_TX_MODE_SPLIT=direct
POLYMARKET_TX_MODE_MERGE=direct
POLYMARKET_TX_MODE_REDEEM=direct
CLOB_SIGNATURE_TYPE=0
CLOB_FUNDER=

# create alchemy api key and add it here
POLYGON_RPC_URL=https://polygon-rpc.com

REDEEM_WATCH_INTERVAL_MS=30000
REDEEM_STATE_PATH=data/redeem/redeemed.json

RECORD_LIVE_INSERT_DB=true

POLYMARKET_EOA_GAS_MULTIPLIER=4


# Split retry config
SPLIT_MAX_RETRY=3           # default: 2
SPLIT_RETRY_DELAY_MS=2000   # default: 3000 (3 sec)

# Merge retry config
MERGE_MAX_RETRY=3           # default: 2
MERGE_RETRY_DELAY_MS=2000   # default: 3000 (3 sec)


# Safe by default: unset (or anything but "false") = dry-run, orders are only
# simulated. Set DRY_RUN=false explicitly to place REAL orders.
# DRY_RUN=false


# only for backtest with technical indicators
BACKTEST_WAIT_FOR_TECHNICAL_INDICATORS=1


# Binance aggTrades external feed (backtests) — defaults shown; usually leave unset.
# Latency: a trade at exchange time T becomes visible at T + this offset
# (default = measured live p50; re-measure with binance:verify-aggtrades).
# BACKTEST_BINANCE_FEED_LATENCY_MS=110
# Pre-window load margin so a price exists at the first tick.
# BACKTEST_BINANCE_FEED_LOOKBACK_MS=300000
# Data root for downloaded/converted Binance dumps (repo-root-anchored when relative).
# BINANCE_DATA_BASE_DIR=data/binance

# priceToBeat external feed (backtests) — default shown; usually leave unset.
# Modeled delay between window start and the strike becoming visible (default =
# live p50 measured by the feeds:parity harness, 2026-07-21: p50=2.65s p90=3.5s
# max=5.4s; re-measure with feeds:parity).
# BACKTEST_PRICE_TO_BEAT_LATENCY_MS=2700

# Chainlink crypto_prices external feed (backtests) — defaults shown; usually
# leave unset. Latency: broadcast→strategy-visibility leg, end-to-end calibrated
# by the feeds:parity harness (re-measure with feeds:parity).
# BACKTEST_RTDS_CHAINLINK_LATENCY_MS=320
# Pre-window load margin so an oracle price exists at the first tick.
# BACKTEST_RTDS_CHAINLINK_LOOKBACK_MS=300000
# Hard-error when the market window contains a stale span longer than this
# (upstream data hole); 0 accepts replaying on the frozen last-known price.
# BACKTEST_RTDS_CHAINLINK_MAX_GAP_MS=300000


# when starting strategy after market start, skip market if bot started too late
SKIP_MARKET_IF_BOT_STARTED_AFTER_SECONDS=15


# Cloudflare R2 (S3-compatible). Token must be an R2 "S3 API" token, not a Workers API token.
# Endpoint format: https://<accountId>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------------
# Backtest parallelization (PR2)
# ----------------------------------------------------------------------------
# Redis queue used by BullMQ for the distributed backtest worker pool.
# Default: redis://localhost:6379 (local brew services).
REDIS_URL=redis://:letsHackPolymarket@localhost:6379

DASHBOARD_ALLOWED_DEV_ORIGINS=100.100.49.80,192.168.0.12
DASHBOARD_HOST=0.0.0.0
# Next.js dashboard (npm run dashboard, lives in dashboard/).
# Reads MySQL + Redis directly. Default port 3051 (3001 is reserved for
# the bot's live WebUI). Pass inline: DASHBOARD_PORT=3055 npm run dashboard
DASHBOARD_PORT=3051

# Bull Board UI (raw queue inspector, npm run bull-board, separate proc).
# Default port 3052. Dashboard nav links to this port automatically.
BULL_BOARD_PORT=3052

# ----------------------------------------------------------------------------
# Telonex
# ----------------------------------------------------------------------------
# Lower bound (ISO 8601 UTC) for telonex markets considered "eligible" for
# backtest coverage reports and queue selection. Markets with marketStartMs
# below this value are excluded from the eligible universe. Move this forward
# to ignore old markets without dropping rows from the catalogue.
TELONEX_DATASET_ELIGIBLE_FROM=2025-12-01T00:00:00Z
# BULL_BOARD_HOST=127.0.0.1
# ----------------------------------------------------------------------------
# Global Runtime (missions) — one daemon per machine, issue #213
# ----------------------------------------------------------------------------
# Address this machine's daemon binds. Leave unset (loopback) for a
# single-machine setup. For the fleet, set it to THIS machine's Tailscale IP —
# it must match the `runtimeUrl` recorded for the machine in
# dashboard/src/data/machines.json, or Mission Control cannot reach it.
# GLOBAL_RUNTIME_HOST=100.107.149.100

# Shared bearer token for the daemon API. The SAME value on every daemon
# machine, the dashboard host, and any machine running the mission CLI
# (openssl rand -hex 32). Required whenever GLOBAL_RUNTIME_HOST is not
# loopback — the daemon refuses to bind a tailnet address without it.
# GLOBAL_RUNTIME_TOKEN=

# Optional: locks the dashboard's Mission Control API, which is otherwise open
# to anything that can reach the dashboard port — including a sandboxed
# mission session on the same machine. Set it on machines that run sandboxed
# missions; unlock a browser once via /mission-control/unlock?token=...
# MISSION_CONTROL_TOKEN=
