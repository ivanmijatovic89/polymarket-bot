{
  "name": "polymarket-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1",
    "record:live": "tsx src/cli/record-live.ts",
    "record:live:btc": "cross-env RECORD_SYMBOL=BTC tsx src/cli/record-live.ts",
    "record:live:eth": "cross-env RECORD_SYMBOL=ETH tsx src/cli/record-live.ts",
    "record:live:sol": "cross-env RECORD_SYMBOL=SOL tsx src/cli/record-live.ts",
    "record:live:xrp": "cross-env RECORD_SYMBOL=XRP tsx src/cli/record-live.ts",
    "trade:bot": "tsx src/cli/trading-bot.ts",
    "trade:bot:btc": "cross-env TRADING_SYMBOL=BTC tsx src/cli/trading-bot.ts",
    "trade:bot:eth": "cross-env TRADING_SYMBOL=ETH tsx src/cli/trading-bot.ts",
    "trade:bot:sol": "cross-env TRADING_SYMBOL=SOL tsx src/cli/trading-bot.ts",
    "trade:bot:xrp": "cross-env TRADING_SYMBOL=XRP tsx src/cli/trading-bot.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "backtest:telonex:btc:15m": "tsx src/cli/backtest.ts --input-mode telonex-delta --read-from local --symbol btc --timeframe 15m",
    "backtest:telonex:eth:15m": "tsx src/cli/backtest.ts --input-mode telonex-delta --read-from local --symbol eth --timeframe 15m",
    "backtest:telonex:sol:15m": "tsx src/cli/backtest.ts --input-mode telonex-delta --read-from local --symbol sol --timeframe 15m",
    "backtest:telonex:xrp:15m": "tsx src/cli/backtest.ts --input-mode telonex-delta --read-from local --symbol xrp --timeframe 15m",
    "list:backtest-files": "tsx src/parquet/cli/list-backtest-files.ts",
    "verify:parquet": "tsx src/parquet/cli/verify-parquet.ts",
    "scan:disconnect-events": "tsx src/parquet/cli/scan-disconnect-events.ts",
    "code:typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "code:typecheck:webui": "npm --prefix webui run code:typecheck",
    "code:typecheck-eslint": "npm run code:typecheck && npm run code:eslint",
    "code:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "code:eslint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "code:prettier:check": "prettier . --check",
    "code:prettier": "prettier . --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:insert-parquet": "tsx src/db/insert-local-parquet-files-to-database.ts",
    "telonex:sync": "tsx src/telonex/sync-markets.ts",
    "telonex:download": "tsx src/telonex/download-raw-files.ts",
    "telonex:convert": "tsx src/telonex/convert.ts",
    "telonex:verify": "tsx src/telonex/verify-conversion.ts",
    "telonex:verify-batch": "tsx src/telonex/verify-conversion-batch.ts",
    "rebuild:chunked-batch-stats": "tsx src/cli/rebuild-chunked-batch-stats.ts --onlyNull",
    "rebuild:chunked-batch-stats:all": "tsx src/cli/rebuild-chunked-batch-stats.ts --force",
    "export:trade-features": "tsx src/cli/research/export-trade-features.ts",
    "webui:dev": "npm --prefix webui run dev",
    "webui:build": "npm --prefix webui run build",
    "webui:preview": "npm --prefix webui run preview",
    "generate:grid:jobs": "tsx ./src/backtest/generate-jobs.ts",
    "relayer:deploy-safe": "tsx src/cli/relayer.ts deploy-safe",
    "relayer:show-safe": "tsx src/cli/relayer.ts show-safe",
    "relayer:approve": "tsx src/cli/relayer.ts approve",
    "relayer:withdraw-usdc": "tsx src/cli/relayer.ts withdraw-usdc",
    "relayer:deposit-usdc": "tsx src/cli/relayer.ts deposit-usdc",
    "relayer:redeem-watcher": "tsx src/cli/redeem-watcher.ts",
    "check:balances": "tsx src/cli/check-balances.ts",
    "clob:api-key": "tsx src/cli/create-clob-api-key.ts",
    "redeem-watcher": "tsx src/cli/redeem-watcher.ts",
    "redeem-watcher:direct": "cross-env POLYMARKET_TX_MODE_REDEEM=direct tsx src/cli/redeem-watcher.ts",
    "redeem-watcher:relayer": "cross-env POLYMARKET_TX_MODE_REDEEM=relayer tsx src/cli/redeem-watcher.ts",
    "eoa:approve-ctf": "tsx src/cli/relayer.ts eoa-approve-ctf",
    "eoa:approve": "tsx src/cli/relayer.ts eoa-approve",
    "make:csv": "tsx src/strategies/split/makeCsv.ts",
    "pmxt:sync-catalog:v1": "tsx src/pmxt/sync-catalog.ts --version v1",
    "pmxt:sync-catalog:v2": "tsx src/pmxt/sync-catalog.ts --version v2",
    "pmxt:download-and-convert:v1": "tsx src/pmxt/download-and-convert-v1.ts --symbol btc",
    "pmxt:download-and-convert:v2": "tsx src/pmxt/download-and-convert-v2.ts --symbol btc",
    "pmxt:resolve-slugs:v2": "tsx src/pmxt/resolve-slugs-v2.ts --symbol btc",
    "pmxt:build-master:v2": "tsx src/pmxt/build-master-v2.ts --symbol btc",
    "r2:upload": "tsx src/r2/upload.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,html,yml,yaml,md}": "prettier --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@duckdb/node-api": "^1.5.2-r.1",
    "@ethersproject/wallet": "^5.7.2",
    "@polymarket/builder-relayer-client": "^0.0.8",
    "@polymarket/builder-signing-sdk": "^0.0.8",
    "@polymarket/clob-client": "^5.1.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "ethers": "^6.16.0",
    "mysql2": "^3.11.5",
    "pino": "^10.1.0",
    "technicalindicators": "^3.1.0",
    "viem": "^2.33.3",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  }
}
