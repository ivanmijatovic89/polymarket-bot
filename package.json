{
  "name": "polymarket-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "record:live": "tsx src/cli/record-live.ts",
    "record:live:btc": "RECORD_SYMBOL=BTC tsx src/cli/record-live.ts",
    "record:live:eth": "RECORD_SYMBOL=ETH tsx src/cli/record-live.ts",
    "record:live:sol": "RECORD_SYMBOL=SOL tsx src/cli/record-live.ts",
    "record:live:xrp": "RECORD_SYMBOL=XRP tsx src/cli/record-live.ts",
    "trade:bot": "tsx src/cli/trading-bot.ts",
    "trade:bot:btc": "TRADING_SYMBOL=BTC tsx src/cli/trading-bot.ts",
    "trade:bot:eth": "TRADING_SYMBOL=ETH tsx src/cli/trading-bot.ts",
    "trade:bot:sol": "TRADING_SYMBOL=SOL tsx src/cli/trading-bot.ts",
    "trade:bot:xrp": "TRADING_SYMBOL=XRP tsx src/cli/trading-bot.ts",
    "backtest": "tsx src/cli/backtest.ts --mode orderbook",
    "list:backtest-files": "tsx src/parquet/cli/list-backtest-files.ts",
    "verify:parquet": "tsx src/parquet/cli/verify-parquet.ts",
    "scan:disconnect-events": "tsx src/parquet/cli/scan-disconnect-events.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
