    "pmxt:download-and-convert:v2": "tsx src/pmxt/download-and-convert-v2.ts --symbol btc",
    "pmxt:resolve-slugs:v2": "tsx src/pmxt/resolve-slugs-v2.ts --symbol btc",
    "pmxt:build-master:v2": "tsx src/pmxt/build-master-v2.ts --symbol btc",
    "r2:upload": "tsx src/r2/upload.ts",
    "research:protocol-size": "tsx strategy-research-protocol/scripts/countProtocolTokens.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,html,yml,yaml,md}": "prettier --write",
