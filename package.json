{
  "name": "polymarket-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "src/backtest/stats",
    "src/llm-usage",
    "dashboard"
  ],
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
