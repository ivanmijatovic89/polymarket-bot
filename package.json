    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.29.1",
    "@dsnp/parquetjs": "^1.8.7",
    "@polymarket/clob-client": "^5.1.2",
