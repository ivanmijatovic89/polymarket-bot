{
  // Typechecks protocol strategies (protocols/*/strategies/) together with src/.
  // Kept OUT of the root tsconfig on purpose: a protocol's type error must never
  // fail the root typecheck that gates unrelated PRs. Run via
  // `npm run code:typecheck:protocols` (non-blocking CI job + shift pre-push).
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "protocols/*/strategies/**/*.ts"]
}
