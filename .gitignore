# dependencies
node_modules/
.npm-cache/
data/
# but keep the dashboard's checked-in machine metadata
!dashboard/src/data/
!dashboard/src/data/**

generated/backtest-jobs/

do-not-commit/

# build output
dist/
build/
out/
# Root-anchored so it only catches test-coverage reports at the repo root,
# not application directories named "coverage" (e.g. the telonex coverage
# feature lives in dashboard/src/components/coverage and src/backtest/stats).
/coverage/
*.tsbuildinfo

# env / secrets
.env
.env.*
!.env.example

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# runtime / caches
.cache/
.tmp/
temp/
.DS_Store

# vitepress cache
docs/.vitepress/cache/

# claude code local settings
.claude/settings.local.json

# IDE / editor
.vscode/
.idea/
*.swp

# optional: local db / sqlite
*.sqlite
*.sqlite3

# optional: turbo / next / vercel (ako koristis)
.vercel/
.next/
.turbo/

duckdb/test.duckdb

# cpu profiles
profiles/

# strategy-research worker run logs (stream-json)
*.jsonl
