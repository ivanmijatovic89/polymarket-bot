{
  "base": "../valid/telonex-delta-ts-compat.json",
  "description": "Each case patches the base job (RFC 6901 pointers; 'set' then 'remove') and names the rule it covers (21 §19 Rust ingress), the expected error (class and cause, 20 §4) from EngineJob::parse, and whether the JSON Schema bundle (Ajv 2020-12, TS shim) rejects it ('reject') or leaves it to the semantic checks ('accept').",
  "cases": [
    {
      "name": "unknown top-level field",
      "rule": "21 §3 closed objects",
      "set": {
        "/extra": 1
      },
      "expect": {
        "class": "invalid_input",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown market field",
      "rule": "21 §3 closed objects",
      "set": {
        "/market/extra": 1
      },
      "expect": {
        "class": "invalid_input",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown field inside modelConfig",
      "rule": "21 §3 closed objects, 14 F-46",
      "set": {
        "/run/modelConfig/feeds/extra": true
      },
      "expect": {
        "class": "invalid_input",
        "cause": "model_config"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "missing modelConfig section",
      "rule": "21 §6 no defaults",
      "remove": ["/run/modelConfig/runner"],
      "expect": {
        "class": "invalid_input",
        "cause": "model_config"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "missing required nullable key",
      "rule": "21 §3 closed objects (null is explicit)",
      "remove": ["/market/journal"],
      "expect": {
        "class": "invalid_input",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "explicit null for an optional key (clock)",
      "rule": "21 §3 closed objects (optional keys are absent, not null)",
      "set": {
        "/run/modelConfig/clock": null
      },
      "expect": {
        "class": "invalid_input",
        "cause": "model_config"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "explicit null for a captured field",
      "rule": "21 §7.1 (captured holds only captured fields)",
