{
  "base": "../valid/ok-ts-compat.json",
  "description": "Each case patches the base result (RFC 6901 pointers; 'set' then 'remove') and names the rule it covers (21 §19 Rust egress and TS shim), the expected error (class and cause, 20 §4) from EngineResult::parse, and whether the JSON Schema bundle (Ajv 2020-12 plus decimalScale, TS shim) rejects it ('reject') or not ('accept').",
  "cases": [
    {
      "name": "unknown top-level field",
      "rule": "21 §3 closed objects",
      "set": {
        "/extra": 1
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown marketStats field (TS-stamped execution)",
      "rule": "21 §11",
      "set": {
        "/candidates/0/output/marketStats/execution": {}
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "missing nullable key",
      "rule": "21 §3 closed objects",
      "remove": ["/candidates/0/output/marketStats/avgEntryPriceDown"],
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "missing stats rules key",
      "rule": "11 §13.8",
      "remove": ["/candidates/0/output/marketStats/rules"],
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unsupported outputSchemaVersion",
      "rule": "20 §3",
      "set": {
        "/outputSchemaVersion": 2
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown eventsByType key",
      "rule": "21 §15, §17",
      "set": {
        "/candidates/0/output/eventsByType/last_trade_price": 3
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown top-level skipReason",
      "rule": "21 §13, §17",
      "set": {
        "/candidates/0/output/skipReason": "no_trades"
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown stats skipReason",
      "rule": "21 §17",
      "set": {
        "/candidates/1/output/marketStats/skipReason": "no_trades"
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown error class (superseded name)",
      "rule": "20 §4, §4.4",
      "set": {
        "/candidates/2/error/class": "strategy_panic"
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown rulesSource",
      "rule": "11 RS4, 21 §17",
      "set": {
        "/market/rulesSource": "captured"
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
    },
    {
      "name": "unknown finalOutcome",
      "rule": "21 §17",
      "set": {
        "/candidates/0/output/marketStats/finalOutcome": "Up"
      },
      "expect": {
        "class": "invalid_output",
        "cause": "schema"
      },
      "jsonSchema": "reject"
