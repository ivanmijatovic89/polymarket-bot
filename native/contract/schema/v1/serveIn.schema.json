  "$id": "https://pmb.invalid/contract/v1/serveIn.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "TS to binary (20 §6.2).",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Caches the run-level section under `contextId`; idempotent.",
      "properties": {
        "contextId": {
          "pattern": "^[!-~]{1,256}$",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/RunSection"
        },
        "type": {
          "const": "context",
          "type": "string"
        }
      },
      "required": ["type", "contextId", "run"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Starts a job; `job.run` is inline or replaced by `job.runRef`.",
      "properties": {
        "job": {
          "$ref": "#/$defs/ServeJob"
        },
        "jobId": {
          "pattern": "^[!-~]{1,256}$",
          "type": "string"
        },
        "type": {
          "const": "job",
          "type": "string"
        }
      },
      "required": ["type", "jobId", "job"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Cooperative abort; the job returns class `canceled`.",
      "properties": {
        "jobId": {
          "pattern": "^[!-~]{1,256}$",
          "type": "string"
        },
        "type": {
          "const": "cancel",
          "type": "string"
        }
      },
      "required": ["type", "jobId"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Liveness probe.",
      "properties": {
        "id": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "ping",
          "type": "string"
        }
      },
      "required": ["type", "id"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Accept no new jobs, finish in-flight jobs, emit `drained`, exit 0.",
      "properties": {
        "type": {
          "const": "drain",
          "type": "string"
        }
      },
      "required": ["type"],
      "type": "object"
    }
  ],
  "title": "ServeIn"
}
